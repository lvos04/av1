[Unit]
Description=AV1 Pipeline frontend
After=network-online.target av1-pipeline-backend.service
Wants=network-online.target

[Service]
Type=simple
User=av1frontend
Group=av1frontend
Environment=NODE_ENV=production
WorkingDirectory=__PROJECT_DIR__/frontend
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
