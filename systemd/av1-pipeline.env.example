# Alleen absolute paden. De backendgebruiker moet hier lees- en schrijfrechten
# hebben; de frontend gebruikt dit bestand niet.
LIBRARY_ROOT=/library
# De eigen 1 TB-SSD: cache, tijdelijke verwerking, configuratie en lokale
# back-ups.
PIPELINE_ROOT=/srv/av1-pipeline
CACHE_ROOT=/srv/av1-pipeline/cache
WORK_ROOT=/srv/av1-pipeline/work
CONFIG_ROOT=/srv/av1-pipeline/config
BACKUP_ROOT=/srv/av1-pipeline/backups
DATABASE_URL=sqlite:////srv/av1-pipeline/config/app.db
LOG_LEVEL=INFO
# Bedieningsinstellingen staan na de eerste start in SQLite en zijn via de UI
# te wijzigen. Deze waarden zijn veilige startsituaties en kunnen bij import
# worden gebruikt; geheime API-sleutels horen niet in dit voorbeeldbestand.
SERVER_NAME=AV1 Pipeline
TIMEZONE=Europe/Amsterdam
CPU_MAX_PERCENT=90
CPU_MAX_TEMPERATURE_C=85
CACHE_WARNING_GB=50
CACHE_PAUSE_GB=10
HARDLINK_MODE=overslaan
TRASH_RETENTION_DAYS=30
CACHE_RESERVE_FACTOR=3
MAX_ACTIVE_JOBS=2
# Door het installatiescript aangemaakt; alleen backend-gebruiker en root mogen
# dit lezen. Nodig om optionele integratiesleutels in SQLite te versleutelen.
SECRET_KEY_FILE=/etc/av1-pipeline-secrets.key
